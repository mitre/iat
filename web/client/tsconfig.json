{
  "compileOnSave": false,
  "compilerOptions": {
    "importHelpers": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2017",
      "dom"
    ],
    "downlevelIteration": true,
    "module": "es2020",
    "baseUrl": "./",
    "useDefineForClassFields": false
  },
  "exclude": [
    "node_modules/*"
  ],
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
